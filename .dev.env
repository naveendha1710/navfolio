# Brevo API Key from brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-YOUR_REAL_BREVO_API_KEY_HERE

# Your personal email address where you want to receive messages
CONTACT_TO_EMAIL=nav.cs@outlook.com

# Your verified sender email address in Brevo (Senders & IP)
BREVO_FROM_EMAIL=nav.cs@outlook.com

# Sender display name shown in your email inbox
BREVO_FROM_NAME=Naveen Portfolio