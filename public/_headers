# Cloudflare Pages: immutable cache for hashed Vite assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PDFs served from public/
/*.pdf
  Cache-Control: public, max-age=86400

# index.html must never be cached (always check for new deployments)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Favicons: cache for a week
/favicon*
  Cache-Control: public, max-age=604800
/apple-touch-icon*
  Cache-Control: public, max-age=604800
/android-chrome*
  Cache-Control: public, max-age=604800