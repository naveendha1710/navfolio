# Cloudflare Pages Functions Environment Variables
# Configure these in the Cloudflare Pages Dashboard (Settings -> Environment Variables)
# or in a local .dev.vars file for Wrangler local development.

# Google Apps Script Webhook URL for logging visitor leads
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Recipient contact email for lead notifications
CONTACT_TO_EMAIL=your_email@example.com
